# --- Static site (GitHub Pages build) ---
NEXT_EXPORT=1
NEXT_PUBLIC_GH_PAGES=1
NEXT_PUBLIC_SITE_URL=https://bhairductcleaningmetrodetroit.com

# Cloudflare Worker quote API (default if unset):
NEXT_PUBLIC_QUOTE_API_URL=https://bhairductcleaningmetrodetroit.com/api/quote
NEXT_PUBLIC_ESTIMATE_API_URL=https://bhairductcleaningmetrodetroit.com/api/estimate

# --- Cloudflare Worker (workers/quote-api) ---
# Deploy: npm run deploy:quote-worker
# Sends to both verified Email Routing destinations (free tier).
QUOTE_TO_EMAIL=israelvaday97@gmail.com
QUOTE_FORWARD_EMAILS=israelvaday97@gmail.com,oren.siyonov@gmail.com
QUOTE_FROM_EMAIL=quotes@bhairductcleaningmetrodetroit.com

# --- Admin estimate console (/admin/estimates) ---
# Deploy: npm run deploy:estimate-worker
# Worker secrets: OPENROUTER_API_KEY + ADMIN_TOKEN (from ESTIMATE_ADMIN_TOKEN)
# Persist: R2 bucket bh-airduct-estimate-pdfs (JSON + PDF) for this domain only
ESTIMATE_ADMIN_TOKEN=

# Workers deploy token:
# Account: Workers Scripts Edit, Workers Routes Edit, Account Settings Read, Workers R2 Storage Edit
# Zone: Workers Routes Edit
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=

# DNS / Email Routing scripts
CLOUDFLARE_DNS_API_TOKEN=
CLOUDFLARE_EMAIL_API_TOKEN=

# OpenRouter (local scripts only)
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
